@unpublished{fabi2025polymarket,
  abbr={Working Paper},
  bibtex_show={false},
  title={Market Efficiency in Prediction Markets: A Comparison with Derivatives},
  author={Fabi, Michele and Marfè, Roberto and Ruffo, Vittorio Maria and Schoenleber, Lorenzo},
  year={2026},
  note={Working Paper},
  abstract={We study pricing efficiency in decentralized prediction markets by comparing Polymarket prices with option-implied prices derived from derivatives. We analyze nearly 5,000 Polymarket contracts written on Bitcoin (BTC) and Ethereum (ETH), two assets for which prediction-market contracts and liquid derivatives markets coexist. We find that Polymarket prices closely track option-implied prices, but systematic deviations remain: they are concentrated in tail and barrier contracts, vary with sentiment, volatility, demand, and market frictions, and imply more probability mass on extreme price movements. To guide our empirical investigation, we introduce a parsimonious limits-to-arbitrage model that formalizes equilibrium behavior in decentralized prediction markets.},
  paper_number={2},
  preview={fabi2025polymarket.png},
  conferences={2026 Decentralized Finance & Crypto Workshop at Scuola Normale Superiore (Pisa);
  2026 5th Workshop on Decentralized Finance (DeFi) in Association with Financial Cryptography 2026 (St. Kitts)*;
  2026 XXVII Workshop on Quantitative Finance (Bergamo);
  2026 Tech 4 Finance #3: AI and Blockchain (Paris);
  2026 Designing DeFi (D2 2026) (New York);
  2026 Frontiers in DeFi 2026 (Berlin)*;
  2026 3rd Structured Retail Products and Derivatives Conference (Hagen);
  2026 Future Finance Fest (3f) (Amsterdam)*;
  2026 8th Future of Financial Information Conference (Frankfurt);
  2025 14th International Moscow Finance Conference (Moscow)*;
  2025 2025 Global AI Finance Research Conference (Hong Kong);
  2025 DeFi Workshop 2025 (Grenoble)*},
  ssrn={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6565258}
}

@unpublished{gerchik2024factor,
  abbr={Working Paper},
  bibtex_show={false},
  title={Factor Dispersions},
  author={Gerchik, Daniil and Ruffo, Vittorio Maria and Schoenleber, Lorenzo and Vilkov, Grigory},
  year={2024},
  note={Working Paper},
  abstract={Dispersion strategies capture the difference in variance dynamics between a basket and its components. Even though smart-beta indices intend to load heavily on a particular factor, factor dispersions based on such baskets are exposed to risks of other factors and idiosyncratic variances. Analyzing factor dispersions through a linear factor model and equicorrelation representations, we recover driving forces behind dispersion dynamics and work out an attribution of a dispersion risk premium. As a balanced combination of systematic and idiosyncratic variance components, dispersion and its risk premium provide signals about future changes in systematic and alpha-based investment opportunities.},
  selected={true},
  award={Winner of the CBOE-The Options Institute-S&P Dow Jones Indices Dispersion Research Grant},
  award_name={CBOE Research Grant},
  paper_number={1},
  preview={gerchik2024factor.png},
  conferences={2025 Second Liverpool Workshop in Option Markets (Liverpool);
  2024 Second Bonn-Frankfurt-Mannheim PhD Conference (Bonn);
  2024 World Federation of Exchanges Research Webinar (online)*;
  2024 Cboe Risk Management Conference 2024 (Snowbird)*;
  2024 2024 FMA Conference on Derivatives and Volatility (Chicago)},
  ssrn={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4853747}
}
