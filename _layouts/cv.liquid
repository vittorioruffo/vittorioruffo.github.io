---
layout: default
---

{% if page.cv_pdf and page.cv_pdf contains '://' %}
  {% assign cv_pdf_url = page.cv_pdf %}
{% elsif page.cv_pdf %}
  {% assign cv_pdf_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
{% endif %}

{% if page.hero_image %}
  <div class="hero-section{% if page.hero_text_color == 'dark' %} hero-dark-text{% endif %}">
    <div class="hero-background" style="background-image: url('{{ page.hero_image | relative_url }}');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="hero-description">{{ page.description }}</p>
      {% endif %}
    </div>
  </div>
{% endif %}

<div class="post">
  {% unless page.hero_image %}
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>
  {% endunless %}

  <article class="cv-pdf-document">
    {% if cv_pdf_url %}
      <div class="site-action-row cv-pdf-actions">
        <a class="site-action-button" href="{{ cv_pdf_url }}" download>
          <i class="fa-solid fa-file-arrow-down"></i>
          Download CV
        </a>
      </div>

      <div class="cv-pdf-renderer" data-pdf-url="{{ cv_pdf_url }}">
        <p class="cv-pdf-loading">Loading CV...</p>
      </div>
      <noscript>
        <p>
          The CV PDF can be opened here:
          <a href="{{ cv_pdf_url }}" target="_blank" rel="noopener noreferrer">Download CV</a>.
        </p>
      </noscript>

      <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
      <script>
        (function () {
          var container = document.querySelector('.cv-pdf-renderer');
          if (!container || !window.pdfjsLib) return;

          var pdfUrl = container.getAttribute('data-pdf-url') + '?v=' + Date.now();
          var renderScale = Math.min(window.devicePixelRatio || 1, 2);
          window.pdfjsLib.GlobalWorkerOptions.workerSrc =
            'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

          window.pdfjsLib.getDocument(pdfUrl).promise.then(function (pdf) {
            container.innerHTML = '';
            var renderPage = function (pageNumber) {
              return pdf.getPage(pageNumber).then(function (page) {
                var baseViewport = page.getViewport({ scale: 1 });
                var targetWidth = Math.min(container.clientWidth || baseViewport.width, 760);
                var displayScale = targetWidth / baseViewport.width;
                var viewport = page.getViewport({ scale: displayScale * renderScale });
                var canvas = document.createElement('canvas');
                var wrapper = document.createElement('div');
                var context = canvas.getContext('2d');

                wrapper.className = 'cv-rendered-page';
                canvas.className = 'cv-pdf-canvas';
                canvas.width = Math.floor(viewport.width);
                canvas.height = Math.floor(viewport.height);
                canvas.style.width = Math.floor(viewport.width / renderScale) + 'px';
                canvas.style.height = Math.floor(viewport.height / renderScale) + 'px';

                wrapper.appendChild(canvas);
                container.appendChild(wrapper);

                return page.render({ canvasContext: context, viewport: viewport }).promise;
              });
            };

            var sequence = Promise.resolve();
            for (var pageNumber = 1; pageNumber <= pdf.numPages; pageNumber += 1) {
              sequence = sequence.then(renderPage.bind(null, pageNumber));
            }
            return sequence;
          }).catch(function () {
            container.innerHTML =
              '<p class="cv-pdf-loading">The CV preview could not load. Use the download button above to open the PDF.</p>';
          });
        })();
      </script>
    {% endif %}
  </article>
</div>
